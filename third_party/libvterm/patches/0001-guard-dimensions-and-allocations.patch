+/* The rest of this file indexes cells with a signed `row * cols + col`.
+ * A product that does not fit in int is not a big screen, it is a write
+ * outside the allocation. */
+static int cell_bytes(int rows, int cols, size_t *bytes)
+{
+  if(rows < 1 || cols < 1)
+    return 0;
+  if((size_t)rows > (size_t)INT_MAX / (size_t)cols)
+    return 0;
+  size_t cells = (size_t)rows * (size_t)cols;
+  if(cells > SIZE_MAX / sizeof(ScreenCell))
+    return 0;
+  *bytes = cells * sizeof(ScreenCell);
+  return 1;
+}
+
 static ScreenCell *alloc_buffer(VTermScreen *screen, int rows, int cols)
 {
-  ScreenCell *new_buffer = vterm_allocator_malloc(screen->vt, sizeof(ScreenCell) * rows * cols);
+  size_t bytes;
+  if(!cell_bytes(rows, cols, &bytes))
+    return NULL;
+
+  ScreenCell *new_buffer = vterm_allocator_malloc(screen->vt, bytes);
+  if(!new_buffer)
+    return NULL;
 
   for(int row = 0; row < rows; row++) {
     for(int col = 0; col < cols; col++) {
@@ -516,16 +539,29 @@ static int line_popcount(ScreenCell *buffer, int row, int rows, int cols)
   return col + 1;
 }
 
